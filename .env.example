# OpsMatrix environment variables — NAMES ONLY, never real values.
# Copy to .env.local for local cloud-mode development; real values for
# staging/production live ONLY in GitHub environment secrets and Supabase
# function secrets (see SETUP_PRODUCTION.md). Without any of these the app
# runs in LOCAL mode: no login, data in this browser — the demo behavior.

# ── cloud mode (baked into the build; safe-to-publish "anon" key, guarded by RLS)
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ── optional overrides
# The Claude proxy endpoint. Defaults to <VITE_SUPABASE_URL>/functions/v1/claude-proxy
# when cloud mode is on; set explicitly only to point elsewhere, or set empty
# to force direct (paste-your-own-key) mode even in a cloud build.
# VITE_CLAUDE_PROXY_URL=

# Error tracking (staging/production builds). No DSN = no monitoring code loaded.
# VITE_SENTRY_DSN=

# ── server-side ONLY — Supabase Edge Function secrets, NEVER in any VITE_ var,
#    never in this repo, never in a build (set via: supabase secrets set …)
# ANTHROPIC_API_KEY=            the environment's workspace-scoped Anthropic key
# ALLOWED_ORIGINS=              comma-separated page origins allowed to call the proxy
# AI_MONTHLY_TOKEN_BUDGET=      per-organization tokens/month (default 20000000)
