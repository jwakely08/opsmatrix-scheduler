{
  "name": "opsmatrix-scheduler",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/copy-pdfjs.cjs && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:classic": "node scripts/copy-pdfjs.cjs && vite build --config vite.fusion.config.ts && node scripts/make-classic.cjs",
    "predev": "node scripts/copy-pdfjs.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "clipper-lib": "^6.4.2",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
